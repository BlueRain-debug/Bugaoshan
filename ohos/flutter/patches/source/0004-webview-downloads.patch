diff --git a/lib/widgets/webview/download_webview.dart b/lib/widgets/webview/download_webview.dart
new file mode 100644
--- /dev/null
+++ b/lib/widgets/webview/download_webview.dart
@@ -0,0 +1,55 @@
+import 'package:flutter/material.dart';
+import 'package:bugaoshan/utils/app_log.dart';
+import 'package:flutter_inappwebview/flutter_inappwebview.dart';
+
+/// 将页面下载逻辑与不同平台版本的 WebView 下载回调隔离。
+class DownloadWebView extends StatelessWidget {
+  static const bool isSupported = true;
+
+  const DownloadWebView({
+    super.key,
+    this.initialUrlRequest,
+    this.initialSettings,
+    this.onWebViewCreated,
+    this.onLoadStart,
+    this.onLoadStop,
+    this.onReceivedError,
+    this.onDownload,
+  });
+
+  final URLRequest? initialUrlRequest;
+  final InAppWebViewSettings? initialSettings;
+  final void Function(InAppWebViewController)? onWebViewCreated;
+  final void Function(InAppWebViewController, WebUri?)? onLoadStart;
+  final void Function(InAppWebViewController, WebUri?)? onLoadStop;
+  final void Function(
+    InAppWebViewController,
+    WebResourceRequest,
+    WebResourceError,
+  )?
+  onReceivedError;
+  final Future<bool> Function(InAppWebViewController, DownloadStartRequest)?
+  onDownload;
+
+  @override
+  Widget build(BuildContext context) {
+    final download = onDownload;
+    return InAppWebView(
+      initialUrlRequest: initialUrlRequest,
+      initialSettings: initialSettings,
+      onWebViewCreated: onWebViewCreated,
+      onLoadStart: onLoadStart,
+      onLoadStop: onLoadStop,
+      onReceivedError: onReceivedError,
+      onDownloadStartRequest: download == null
+          ? null
+          : (controller, request) async {
+              try {
+                await download(controller, request);
+              } catch (error) {
+                AppLog.e('DownloadWebView', 'Download callback failed: $error');
+              }
+            },
+    );
+  }
+}
