import 'package:bugaoshan/widgets/common/auth_scoped_indexed_stack.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

void main() {
  testWidgets('only visited pages initialize and retain state across reordering', (
    tester,
  ) async {
    final authenticated = ValueNotifier<bool>(true);
    final selected = ValueNotifier<int>(0);
    final pages = ValueNotifier<List<String>>(['a', 'b', 'c']);
    final created = <String, int>{};
    final disposed = <String, int>{};
    await tester.pumpWidget(
      _app(authenticated, selected, pages, created, disposed),
    );

    expect(created, {'a': 1});
    expect(find.text('b:0', skipOffstage: false), findsNothing);
    await tester.tap(find.text('a:0'));
    await tester.pump();

    selected.value = 1;
    await tester.pump();
    expect(created, {'a': 1, 'b': 1});
    expect(find.text('b:0'), findsOneWidget);

    // Reordering the dock must not recreate an already visited page.
    pages.value = ['c', 'b', 'a'];
    selected.value = 2;
    await tester.pump();
    expect(find.text('a:1'), findsOneWidget);
    expect(created, {'a': 1, 'b': 1});
    expect(disposed, isEmpty);

    pages.value = ['a'];
    selected.value = 0;
    await tester.pump();
    expect(disposed, {'b': 1});
    expect(find.text('a:1'), findsOneWidget);

    pages.value = [];
    await tester.pump();
    expect(disposed, {'a': 1, 'b': 1});
    pages.value = ['a'];
    await tester.pump();
    expect(find.text('a:0'), findsOneWidget);
    expect(created, {'a': 2, 'b': 1});

    await tester.pumpWidget(const SizedBox.shrink());
    authenticated.dispose();
    selected.dispose();
    pages.dispose();
  });

  testWidgets('authentication changes discard every visited page state', (
    tester,
  ) async {
    final authenticated = ValueNotifier<bool>(true);
    final selected = ValueNotifier<int>(0);
    final pages = ValueNotifier<List<String>>(['a', 'b']);
    final created = <String, int>{};
    final disposed = <String, int>{};
    await tester.pumpWidget(
      _app(authenticated, selected, pages, created, disposed),
    );
    await tester.tap(find.text('a:0'));
    await tester.pump();
    selected.value = 1;
    await tester.pump();

    authenticated.value = false;
    await tester.pump();
    expect(disposed, {'a': 1, 'b': 1});
    expect(created, {'a': 1, 'b': 2});
    expect(find.text('b:0'), findsOneWidget);

    authenticated.value = true;
    await tester.pump();
    expect(created, {'a': 1, 'b': 3});
    selected.value = 0;
    await tester.pump();
    expect(find.text('a:0'), findsOneWidget);
    expect(created, {'a': 2, 'b': 3});

    await tester.pumpWidget(const SizedBox.shrink());
    authenticated.dispose();
    selected.dispose();
    pages.dispose();
  });
}

Widget _app(
  ValueNotifier<bool> authenticated,
  ValueNotifier<int> selected,
  ValueNotifier<List<String>> pages,
  Map<String, int> created,
  Map<String, int> disposed,
) {
  return MaterialApp(
    home: ListenableBuilder(
      listenable: Listenable.merge([selected, pages]),
      builder: (context, _) => AuthScopedIndexedStack(
        authListenable: authenticated,
        isAuthenticated: () => authenticated.value,
        visibleIds: pages.value,
        selectedIndex: selected.value,
        enableAnimation: false,
        pageBuilder: (id) => _Page(
          id: id,
          onCreated: () =>
              created.update(id, (value) => value + 1, ifAbsent: () => 1),
          onDisposed: () =>
              disposed.update(id, (value) => value + 1, ifAbsent: () => 1),
        ),
      ),
    ),
  );
}

class _Page extends StatefulWidget {
  const _Page({
    required this.id,
    required this.onCreated,
    required this.onDisposed,
  });

  final String id;
  final VoidCallback onCreated;
  final VoidCallback onDisposed;

  @override
  State<_Page> createState() => _PageState();
}

class _PageState extends State<_Page> {
  int _count = 0;

  @override
  void initState() {
    super.initState();
    widget.onCreated();
  }

  @override
  void dispose() {
    widget.onDisposed();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return TextButton(
      onPressed: () => setState(() => _count++),
      child: Text('${widget.id}:$_count'),
    );
  }
}
