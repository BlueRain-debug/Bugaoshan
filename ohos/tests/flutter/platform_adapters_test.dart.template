import 'dart:io';

import 'package:bugaoshan/utils/file_save.dart';
import 'package:bugaoshan/utils/gallery_save.dart';
import 'package:file_picker_ohos/file_picker_ohos.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';

class _Picker extends FilePicker {
  String? destination = 'file://docs/calendar.ics';
  Uint8List? receivedBytes;
  String? receivedName;

  @override
  Future<String?> saveFile({
    String? dialogTitle,
    String? fileName,
    String? initialDirectory,
    FileType type = FileType.any,
    List<String>? allowedExtensions,
    Uint8List? bytes,
    bool lockParentWindow = false,
  }) async {
    receivedBytes = bytes;
    receivedName = fileName;
    return destination;
  }
}

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  test(
    'file save passes generated ICS bytes and preserves cancellation',
    () async {
      final previous = FilePicker.platform;
      final picker = _Picker();
      FilePicker.platform = picker;
      addTearDown(() => FilePicker.platform = previous);
      final bytes = Uint8List.fromList(
        'BEGIN:VCALENDAR\r\nEND:VCALENDAR'.codeUnits,
      );
      expect(
        await saveFileBytes(
          dialogTitle: 'Save',
          fileName: 'calendar.ics',
          bytes: bytes,
        ),
        isTrue,
      );
      expect(picker.receivedBytes, bytes);
      expect(picker.receivedName, 'calendar.ics');
      picker.destination = null;
      expect(
        await saveFileBytes(
          dialogTitle: 'Save',
          fileName: 'calendar.ics',
          bytes: bytes,
        ),
        isFalse,
      );
    },
  );

  const channel = MethodChannel('image_gallery_saver_plus');
  final messenger =
      TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
  setUp(() {
    messenger.setMockMethodCallHandler(
      const MethodChannel('plugins.flutter.io/path_provider'),
      (call) async => Directory.systemTemp.path,
    );
  });
  tearDown(() {
    messenger.setMockMethodCallHandler(
      const MethodChannel('plugins.flutter.io/path_provider'),
      null,
    );
  });
  final bytes = Uint8List.fromList([
    0x47,
    0x49,
    0x46,
    0x38,
    0x39,
    0x61,
    1,
    2,
    3,
  ]);

  for (final outcome in ['success', 'cancel', 'failure']) {
    test(
      'gallery $outcome preserves bytes and removes temporary files',
      () async {
        String? savedPath;
        messenger.setMockMethodCallHandler(channel, (call) async {
          expect(call.method, 'saveFileToGallery');
          savedPath = (call.arguments as Map)['file'] as String;
          expect(savedPath, endsWith('.gif'));
          expect(await File(savedPath!).readAsBytes(), bytes);
          return {
            'isSuccess': outcome == 'success',
            'message': outcome == 'cancel'
                ? 'user refuses permission'
                : 'write failed',
          };
        });
        addTearDown(() => messenger.setMockMethodCallHandler(channel, null));
        if (outcome == 'failure') {
          await expectLater(
            saveImageBytesToGallery(bytes),
            throwsA(isA<PlatformException>()),
          );
        } else {
          expect(await saveImageBytesToGallery(bytes), outcome == 'success');
        }
        expect(savedPath, isNotNull);
        expect(await File(savedPath!).exists(), isFalse);
      },
    );
  }
}
