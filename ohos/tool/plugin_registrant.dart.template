// Materialized only in the OH Flutter package, where yaml is resolved by its lock.
import 'dart:convert';
import 'dart:io';

// Tool-only reader: yaml is pinned transitively by the OH build_runner lock.
// ignore: depend_on_referenced_packages
import 'package:yaml/yaml.dart';

void main() {
  final metadata = jsonDecode(
    File('.flutter-plugins-dependencies').readAsStringSync(),
  ) as Map<String, dynamic>;
  final plugins = (metadata['plugins']['ohos'] as List)
      .cast<Map<String, dynamic>>()
    ..sort((left, right) =>
        (left['name'] as String).compareTo(right['name'] as String));
  final result = <Map<String, String>>[];
  for (final plugin in plugins) {
    if (plugin['native_build'] == false) continue;
    final directory = Directory(plugin['path'] as String);
    final pubspec = loadYaml(
      File.fromUri(directory.uri.resolve('pubspec.yaml')).readAsStringSync(),
    ) as YamlMap;
    final platform = pubspec['flutter']?['plugin']?['platforms']?['ohos'];
    if (platform is! YamlMap) {
      throw StateError('Missing OH plugin declaration: ${plugin['name']}');
    }
    final pluginClass = platform['pluginClass'];
    // FFI-only native libraries have no method-channel class to register.
    if (pluginClass == null) continue;
    result.add({
      'name': plugin['name'] as String,
      'class': pluginClass as String,
    });
  }
  stdout.writeln(jsonEncode(result));
}
